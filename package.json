{
    "name": "csharp-helper",
    "displayName": "C# Helper",
    "description": "small features to help vscode csharp desing",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/cwlinroc/csharp-helper"
    },
    "license": "MIT",
    "publisher": "cwlinroc",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "csharp-helper.fix-namespace",
                "title": "Fix Namespace (C#)"
            },
            {
                "command": "csharp-helper.toggle-method-sync",
                "title": "Toggle Method Sync (C#)"
            },
            {
                "command": "csharp-helper.fix-filename",
                "title": "Fix Filename (C#)"
            },
            {
                "command": "csharp-helper.create-class-template",
                "title": "Create Class Template (C#)"
            },
            {
                "command": "csharp-helper.create-interface-template",
                "title": "Create Interface Template (C#)"
            },
            {
                "command": "csharp-helper.create-enum-template",
                "title": "Create Enum Template (C#)"
            },
            {
                "command": "csharp-helper.create-struct-template",
                "title": "Create Struct Template (C#)"
            },
            {
                "command": "csharp-helper.create-record-template",
                "title": "Create Record Template (C#)"
            },
            {
                "command": "csharp-helper.create-razor-page",
                "title": "Create Razor Page (C#)"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
        "self-host": "npx @vscode/vsce package --no-dependencies",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "10.0.10",
        "@types/node": "25.6.0",
        "@types/vscode": "1.100.0",
        "@vscode/test-cli": "0.0.12",
        "@vscode/test-electron": "2.5.2",
        "esbuild": "0.28.0",
        "eslint": "10.2.0",
        "npm-run-all2": "^8.0.4",
        "typescript": "6.0.2",
        "typescript-eslint": "8.58.1"
    },
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
